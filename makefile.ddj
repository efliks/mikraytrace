# Host: MS-DOS
# Target: MS-DOS
# Compiler: DJGPP

# Before running make, set up the DJGPP environment:
#   SET DJGPP=C:\DJGPP\DJGPP.ENV
#   SET PATH=C:\DJGPP\BIN;%PATH%
#
# The "clean" target uses rm from the DJGPP fileutils package (fil*b.zip).

CXX = gpp
CXXFLAGS = -std=c++98 -W -Wall -pedantic -O2 -Isrc -Ideps/lodepng -Ideps/toojpeg
LDFLAGS = 
LDLIBS = -lm

TARGET = mrtp_cli.exe

OBJS = \
	src/actors.o \
	src/camera.o \
	src/config.o \
	src/light.o \
	src/main.o \
	src/mappers.o \
	src/matrix3.o \
	src/renderer.o \
	src/texture.o \
	src/vector3.o \
	src/world.o \
	src/writer.o \
	src/banner.o \
	src/cube.o \
	src/cylinder.o \
	src/mesh.o \
	src/molecule.o \
	src/plane.o \
	src/polygon.o \
	src/sphere.o \
	src/tools.o \
	src/triangle.o \
	deps/lodepng/lodepng.o \
	deps/toojpeg/toojpeg.o

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $(TARGET) $(OBJS) $(LDLIBS)

src/actors.o: src/actors.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/camera.o: src/camera.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/config.o: src/config.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/light.o: src/light.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/main.o: src/main.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/mappers.o: src/mappers.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/matrix3.o: src/matrix3.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/renderer.o: src/renderer.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/texture.o: src/texture.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/vector3.o: src/vector3.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/world.o: src/world.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/writer.o: src/writer.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/banner.o: src/banner.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/cube.o: src/cube.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/cylinder.o: src/cylinder.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/mesh.o: src/mesh.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/molecule.o: src/molecule.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/plane.o: src/plane.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/polygon.o: src/polygon.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/sphere.o: src/sphere.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/tools.o: src/tools.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

src/triangle.o: src/triangle.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

deps/lodepng/lodepng.o: deps/lodepng/lodepng.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

deps/toojpeg/toojpeg.o: deps/toojpeg/toojpeg.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

clean:
	rm -f $(TARGET) $(OBJS)
